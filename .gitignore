# Heavy datasets and raw exports (Never commit large raw data)
data/raw/*
!data/raw/.gitkeep
data/bronze/*
!data/bronze/.gitkeep
data/silver/*
!data/silver/.gitkeep
data/gold/*.parquet
!data/gold/.gitkeep

# ML Model Heavy Binary Artifacts (keep sample / lightweight serialized metadata)
ml/artifacts/*.joblib
ml/artifacts/*.pkl
ml/artifacts/*.bin
!ml/artifacts/.gitkeep
!ml/artifacts/metrics.json

# Spark temporary warehouse
spark-warehouse/
metastore_db/
derby.log
